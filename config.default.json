{
  "port": 4517,
  "language": "Korean",
  "turnTimeoutSec": 1800,
  "testTimeoutSec": 600,
  "contextBudgetChars": 60000,
  "agents": {
    "claude": {
      "label": "Claude",
      "color": "#d97757",
      "enabled": true,
      "cmd": "claude",
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "WebSearch",
          "WebFetch",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "role": "균형 잡힌 중재자: 기술적 디테일과 큰 그림 사이 한가운데에 서서, Codex의 엄밀함과 Gemini의 통찰을 서로의 언어로 옮기고 실용적인 결론으로 묶는다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "login": "claude"
      },
      "models": [
        "fable",
        "opus",
        "sonnet",
        "haiku"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    },
    "deepseek": {
      "label": "DeepSeek",
      "color": "#7c5cff",
      "enabled": true,
      "cmd": "claude",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "${DEEPSEEK_API_KEY}",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_MODEL": "deepseek-chat",
        "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-chat",
        "API_TIMEOUT_MS": "600000",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "role": "메인 구현자: 합의된 계획과 모더레이터의 작업 지시를 그대로 따라 완성도 높은 코드를 빠르게 쓰고 테스트를 돌린다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "deepseek-chat",
      "executor": true,
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "key": "DEEPSEEK_API_KEY"
      },
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ]
    },
    "codex": {
      "label": "Codex",
      "color": "#10a37f",
      "enabled": true,
      "cmd": "codex",
      "args": {
        "base": [
          "exec",
          "--skip-git-repo-check",
          "--ephemeral",
          "--color",
          "never",
          "--output-last-message",
          "{lastMessageFile}"
        ],
        "read": [
          "--sandbox",
          "read-only",
          "-c",
          "approval_policy=never"
        ],
        "write": [
          "--sandbox",
          "workspace-write",
          "-c",
          "approval_policy=never",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "tail": [
          "-"
        ]
      },
      "input": "stdin",
      "parser": "text",
      "finalFrom": "lastMessageFile",
      "role": "집요한 기술 장인: 말을 문자 그대로 받아들이고 돌려 말하지 않는다. 사실, 규칙, 엣지 케이스, 정확성·테스트·성능·보안에만 몰두하며 모든 주장을 직접 코드를 실행해 검증한다. 분위기나 체면보다 틀린 것을 틀렸다고 말하는 것이 우선이다.",
      "modelArgs": [
        "-m",
        "{model}"
      ],
      "model": "",
      "setup": {
        "npm": "@openai/codex",
        "login": "codex login"
      },
      "modelsCmd": [
        "debug",
        "models"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort={effort}"
      ],
      "effort": ""
    },
    "gemini": {
      "label": "Gemini",
      "color": "#4f8df7",
      "enabled": true,
      "cmd": "agy",
      "args": {
        "base": [
          "--input-format",
          "stream-json",
          "--output-format",
          "stream-json"
        ],
        "read": [
          "--mode",
          "plan"
        ],
        "write": [
          "--dangerously-skip-permissions"
        ],
        "tail": [
          "-p="
        ]
      },
      "input": "agy-json",
      "parser": "agy-stream-json",
      "readNote": "Note: in this turn shell commands are blocked, and trying one ends your turn with no answer. Use only file viewing and search tools, then write your answer.",
      "role": "통찰력 있는 현인: 기술 세부보다 세상과 사람, 역사와 맥락을 넓게 이해한다. '왜 하는가', '실제 사람들에게 무슨 의미인가'를 묻고, 다른 분야의 선행 사례와 비유로 모두가 놓친 큰 그림과 숨은 전제를 짚는다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "setup": {
        "login": "agy"
      },
      "modelsCmd": [
        "models"
      ],
      "modelsFormat": "agy-tsv",
      "modelsFilter": "^gemini-",
      "models": [
        "gemini-4-argon",
        "gemini-3.8-flash"
      ],
      "efforts": [
        "low",
        "medium",
        "high"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    }
  },
  "preflight": true,
  "limitBackoffSec": [
    60,
    180,
    600,
    1200,
    1800
  ],
  "networkRetrySec": [
    10,
    30,
    60
  ],
  "maxConcurrentSessions": 4,
  "escalationOrder": [
    "claude",
    "codex",
    "gemini"
  ],
  "escalateAfterFailedTests": 2
}
