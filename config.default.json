{
  "port": 4517,
  "language": "Korean",
  "turnTimeoutSec": 1800,
  "testTimeoutSec": 600,
  "contextBudgetChars": 60000,
  "agents": {
    "claude": {
      "label": "Claude",
      "color": "#d97757",
      "enabled": true,
      "cmd": "claude",
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "WebSearch",
          "WebFetch",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "role": "설계자·비평가: 설계의 타당성, 예외 상황, 정확성, 장기 유지보수성을 따진다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "login": "claude"
      },
      "models": [
        "fable",
        "opus",
        "sonnet",
        "haiku"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    },
    "deepseek": {
      "label": "DeepSeek",
      "color": "#7c5cff",
      "enabled": true,
      "cmd": "claude",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "${DEEPSEEK_API_KEY}",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_MODEL": "deepseek-chat",
        "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-chat",
        "API_TIMEOUT_MS": "600000",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "role": "메인 구현자: 합의된 계획과 모더레이터의 작업 지시를 그대로 따라 완성도 높은 코드를 빠르게 쓰고 테스트를 돌린다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "deepseek-chat",
      "executor": true,
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "key": "DEEPSEEK_API_KEY"
      },
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ]
    },
    "codex": {
      "label": "Codex",
      "color": "#10a37f",
      "enabled": true,
      "cmd": "codex",
      "args": {
        "base": [
          "exec",
          "--skip-git-repo-check",
          "--ephemeral",
          "--color",
          "never",
          "--output-last-message",
          "{lastMessageFile}"
        ],
        "read": [
          "--sandbox",
          "read-only",
          "-c",
          "approval_policy=never"
        ],
        "write": [
          "--sandbox",
          "workspace-write",
          "-c",
          "approval_policy=never",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "tail": [
          "-"
        ]
      },
      "input": "stdin",
      "parser": "text",
      "finalFrom": "lastMessageFile",
      "role": "엄격한 코드 리뷰어: 정확성, 테스트, 성능, 보안을 보고 직접 코드를 실행해 주장을 검증한다.",
      "modelArgs": [
        "-m",
        "{model}"
      ],
      "model": "",
      "setup": {
        "npm": "@openai/codex",
        "login": "codex login"
      },
      "modelsCmd": [
        "debug",
        "models"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort={effort}"
      ],
      "effort": ""
    },
    "gemini": {
      "label": "Gemini",
      "color": "#4f8df7",
      "enabled": true,
      "cmd": "agy",
      "args": {
        "base": [
          "--input-format",
          "stream-json",
          "--output-format",
          "stream-json"
        ],
        "read": [
          "--mode",
          "plan"
        ],
        "write": [
          "--dangerously-skip-permissions"
        ],
        "tail": [
          "-p="
        ]
      },
      "input": "agy-json",
      "parser": "agy-stream-json",
      "readNote": "Note: in this turn shell commands are blocked, and trying one ends your turn with no answer. Use only file viewing and search tools, then write your answer.",
      "role": "반대 측 논객·리서처: 전제를 의심하고 대안과 선행 사례, 외부 지식을 가져온다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "setup": {
        "login": "agy"
      },
      "modelsCmd": [
        "models"
      ],
      "modelsFormat": "agy-tsv",
      "modelsFilter": "^gemini-",
      "models": [
        "gemini-4-argon",
        "gemini-3.8-flash"
      ],
      "efforts": [
        "low",
        "medium",
        "high"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    }
  },
  "preflight": true,
  "limitBackoffSec": [
    60,
    180,
    600,
    1200,
    1800
  ],
  "networkRetrySec": [
    10,
    30,
    60
  ],
  "maxConcurrentSessions": 4,
  "escalationOrder": [
    "claude",
    "codex",
    "gemini"
  ],
  "escalateAfterFailedTests": 2
}
