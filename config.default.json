{
  "port": 4517,
  "language": "Korean",
  "discussionLanguage": "English",
  "turnTimeoutSec": 1800,
  "testTimeoutSec": 600,
  "contextBudgetChars": 60000,
  "agents": {
    "claude": {
      "label": "Claude",
      "color": "#d97757",
      "enabled": true,
      "cmd": "claude",
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "WebSearch",
          "WebFetch",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "allowArgs": [
        "--allowedTools",
        "{rule}"
      ],
      "role": "균형 잡힌 중재자: 기술적 디테일과 큰 그림 사이 한가운데에 서서, Codex의 엄밀함과 Gemini의 통찰을 서로의 언어로 옮기고 실용적인 결론으로 묶는다.",
      "labRole": "PI(연구 책임자) 겸 중재자: 연구 질문을 날카롭게 다듬고, 경쟁하는 가설들을 한 무대에 올려 가장 판별력 있는 사고실험을 고른다. Codex의 형식적 엄밀성과 Gemini의 넓은 시야를 하나의 검증 가능한 가설로 묶고, 이 연구의 기여가 정확히 무엇인지 끝까지 묻는다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "stepInModel": "opus",
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "login": "claude"
      },
      "models": [
        "fable",
        "opus",
        "sonnet",
        "haiku"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    },
    "deepseek": {
      "label": "DeepSeek",
      "color": "#7c5cff",
      "enabled": true,
      "cmd": "claude",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_AUTH_TOKEN": "${DEEPSEEK_API_KEY}",
        "ANTHROPIC_API_KEY": "",
        "ANTHROPIC_MODEL": "deepseek-chat",
        "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-chat",
        "API_TIMEOUT_MS": "600000",
        "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
      },
      "args": {
        "base": [
          "-p",
          "--output-format",
          "stream-json",
          "--verbose"
        ],
        "read": [
          "--allowedTools",
          "Read",
          "Grep",
          "Glob",
          "Bash(git diff:*)",
          "Bash(git log:*)",
          "Bash(git status:*)"
        ],
        "write": [
          "--permission-mode",
          "bypassPermissions"
        ],
        "tail": []
      },
      "input": "stdin",
      "parser": "claude-stream-json",
      "allowArgs": [
        "--allowedTools",
        "{rule}"
      ],
      "role": "묵묵한 구현자: 토론에 끼지 않고, 합의된 계획과 모더레이터의 작업 지시를 그대로 따라 완성도 높은 코드를 빠르게 쓰고 테스트를 돌린다. 비평은 변명 없이 반영한다.",
      "labRole": "연구 엔지니어: 토론에 끼지 않고 합의된 실험을 그대로 코드로 구현해 실행한다. 명령·시드·버전·원본 결과를 빠짐없이 남기고, 비평은 변명 없이 반영한다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "deepseek-chat",
      "executor": true,
      "setup": {
        "npm": "@anthropic-ai/claude-code",
        "key": "DEEPSEEK_API_KEY"
      },
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ]
    },
    "codex": {
      "label": "Codex",
      "color": "#10a37f",
      "enabled": true,
      "cmd": "codex",
      "args": {
        "base": [
          "exec",
          "--skip-git-repo-check",
          "--ephemeral",
          "--color",
          "never",
          "--output-last-message",
          "{lastMessageFile}"
        ],
        "read": [
          "--sandbox",
          "read-only",
          "-c",
          "approval_policy=never"
        ],
        "write": [
          "--sandbox",
          "workspace-write",
          "-c",
          "approval_policy=never",
          "-c",
          "sandbox_workspace_write.network_access=true"
        ],
        "tail": [
          "-"
        ]
      },
      "input": "stdin",
      "parser": "text",
      "finalFrom": "lastMessageFile",
      "role": "집요한 기술 장인: 말을 문자 그대로 받아들이고 돌려 말하지 않는다. 사실, 규칙, 엣지 케이스, 정확성·테스트·성능·보안에만 몰두하며 모든 주장을 직접 코드를 실행해 검증한다. 분위기나 체면보다 틀린 것을 틀렸다고 말하는 것이 우선이다.",
      "labRole": "엄밀성 담당 연구자: 가설을 정식화하고 사고실험을 수식으로 끝까지 계산해 검증한다. 정의·가정·유도를 한 줄씩 검산하고 반례와 극한 사례를 찾으며, 베이스라인·통계·데이터 누수·평가 지표의 함정을 집요하게 파고든다. 수식과 코드로 말한다.",
      "modelArgs": [
        "-m",
        "{model}"
      ],
      "model": "",
      "setup": {
        "npm": "@openai/codex",
        "login": "codex login"
      },
      "modelsCmd": [
        "debug",
        "models"
      ],
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort={effort}"
      ],
      "effort": ""
    },
    "gemini": {
      "label": "Gemini",
      "color": "#4f8df7",
      "enabled": true,
      "cmd": "agy",
      "args": {
        "base": [
          "--input-format",
          "stream-json",
          "--output-format",
          "stream-json"
        ],
        "read": [
          "--mode",
          "plan"
        ],
        "write": [
          "--dangerously-skip-permissions"
        ],
        "tail": [
          "-p="
        ]
      },
      "input": "agy-json",
      "parser": "agy-stream-json",
      "readNote": "Note: in this turn shell commands and web/URL fetching are blocked, and trying one ends your turn with no answer. Use only file viewing and search tools, answer from your own knowledge, then write your answer.",
      "role": "통찰력 있는 현인: 기술 세부보다 세상과 사람, 역사와 맥락을 넓게 이해한다. '왜 하는가', '실제 사람들에게 무슨 의미인가'를 묻고, 다른 분야의 선행 사례와 비유로 모두가 놓친 큰 그림과 숨은 전제를 짚는다.",
      "labRole": "넓은 시야의 선임 연구자: 분야를 가로지르는 문헌과 역사를 꿰고, 다른 분야에서 대담한 가설과 경쟁 메커니즘을 끌어온다. 이 연구가 왜 중요한지, 숨은 가정이 무엇인지 묻고, 가장 가까운 선행연구로 공격하는 Reviewer 2다.",
      "modelArgs": [
        "--model",
        "{model}"
      ],
      "model": "",
      "setup": {
        "login": "agy"
      },
      "modelsCmd": [
        "models"
      ],
      "modelsFormat": "agy-tsv",
      "modelsFilter": "^gemini-",
      "models": [
        "gemini-4-argon",
        "gemini-3.8-flash"
      ],
      "efforts": [
        "low",
        "medium",
        "high"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "effort": ""
    }
  },
  "preflight": true,
  "limitBackoffSec": [
    60,
    180,
    600,
    1200,
    1800
  ],
  "networkRetrySec": [
    10,
    30,
    60
  ],
  "maxConcurrentSessions": 4,
  "escalationOrder": [
    "claude"
  ],
  "escalateAfterFailedTests": 2,
  "minBuildRounds": 4
}
