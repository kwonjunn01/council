{
  "name": "council",
  "version": "0.3.0",
  "description": "Make Claude Code, Codex and Gemini CLI debate and build a project together",
  "main": "electron/main.js",
  "bin": {
    "council": "server.js"
  },
  "scripts": {
    "start": "node server.js",
    "mock": "node server.js --mock",
    "test": "node test/e2e.js",
    "desktop": "electron .",
    "desktop:mock": "electron . --mock",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "kwonjunn01",
    "email": "kwonjunn01@yonsei.ac.kr"
  },
  "build": {
    "appId": "dev.council.app",
    "productName": "Council",
    "artifactName": "Council-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "lib/**",
      "public/**",
      "electron/**",
      "mock/**",
      "build/icon.*",
      "config.default.json",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Council"
    },
    "portable": {
      "artifactName": "Council-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "publish": {
      "provider": "github",
      "owner": "kwonjunn01",
      "repo": "council"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kwonjunn01/council.git"
  },
  "homepage": "https://github.com/kwonjunn01/council"
}
